# Copy this file to .env and fill in the values.

# "meta" = Meta's Cloud API directly (good for testing with Meta's free test number)
# "360dialog" = through 360dialog (needed for coexistence: keep using the WhatsApp Business App on the same number)
WHATSAPP_PROVIDER=meta

# --- If WHATSAPP_PROVIDER=meta: from developers.facebook.com > your app > WhatsApp > API Setup
WHATSAPP_TOKEN=your-permanent-or-temporary-access-token
WHATSAPP_PHONE_NUMBER_ID=123456789012345
# Any secret string you choose. Enter the same value in the Meta webhook settings.
WHATSAPP_VERIFY_TOKEN=rival-sports-verify-123

# --- If WHATSAPP_PROVIDER=360dialog: the API key from your 360dialog hub
D360_API_KEY=your-360dialog-api-key

# After you reply to a customer yourself from the WhatsApp Business App, the bot stays quiet
# with that customer for this many hours. The customer can type "menu" to bring the bot back.
BOT_PAUSE_HOURS=4

PORT=5000
